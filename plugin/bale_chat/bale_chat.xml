<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
  <element>bale_chat</element>
  <namespace path="src">Joomla\Plugin\System\BaleChat</namespace>
  <name>Bale ChatBox Widget</name>
  <author>Vafa</author>
  <creationDate>2024-04-01</creationDate>
  <copyright>Copyright (C) 2024. All rights reserved.</copyright>
  <license>Custom Non-Commercial License; see LICENSE.txt</license>
  <authorEmail>contact@vafagh.dev</authorEmail>
  <authorUrl>https://github.com/vafagh</authorUrl>
  <version>1.1.0</version>
  <description>Floating chat widget for Joomla — keeps your visitors connected to site admins even during Iran internet disruptions. Bale Messenger is accessible both inside and outside Iran; Telegram serves as fallback. Visitors submit their contact (Bale/Telegram/WhatsApp preference) via a secure AJAX form with CSRF and optional CAPTCHA; admin is notified via Bale or Telegram bot.</description>

  <files>
    <folder>src</folder>
    <folder>media</folder>
    <folder>services</folder>
  </files>

  <config>
    <fields name="params">
      <fieldset name="basic" label="PLG_SYSTEM_BALE_CHAT_SETTINGS">
        <field name="primary_service" type="list" label="PLG_SYSTEM_BALE_CHAT_PRIMARY_SERVICE" description="PLG_SYSTEM_BALE_CHAT_PRIMARY_SERVICE_DESC" default="bale">
          <option value="bale">Bale Messenger</option>
          <option value="telegram">Telegram</option>
        </field>
        <field name="captcha_provider" type="list" label="PLG_SYSTEM_BALE_CHAT_CAPTCHA_PROVIDER" description="PLG_SYSTEM_BALE_CHAT_CAPTCHA_PROVIDER_DESC" default="none">
          <option value="none">Disabled</option>
          <option value="recaptcha">Google reCAPTCHA v2</option>
          <option value="turnstile">Cloudflare Turnstile</option>
        </field>
      </fieldset>
      
      <fieldset name="bale" label="PLG_SYSTEM_BALE_CHAT_BALE_SETTINGS">
        <field name="bale_setup_note" type="note" heading="h4" label="PLG_SYSTEM_BALE_CHAT_BALE_SETUP_NOTE" description="PLG_SYSTEM_BALE_CHAT_BALE_SETUP_NOTE_DESC" />
        <field name="bale_bot_username" type="text" label="PLG_SYSTEM_BALE_CHAT_BALE_USERNAME" description="PLG_SYSTEM_BALE_CHAT_BALE_USERNAME_DESC" />
        <field name="bale_bot_token" type="password" label="PLG_SYSTEM_BALE_CHAT_BALE_TOKEN" description="PLG_SYSTEM_BALE_CHAT_BALE_TOKEN_DESC" />
        <field name="bale_chatid_note" type="note" heading="h4" label="PLG_SYSTEM_BALE_CHAT_BALE_CHATID_NOTE" description="PLG_SYSTEM_BALE_CHAT_BALE_CHATID_NOTE_DESC" class="alert alert-warning" />
        <field name="bale_chat_id" type="text" label="PLG_SYSTEM_BALE_CHAT_BALE_CHAT_ID" description="PLG_SYSTEM_BALE_CHAT_BALE_CHAT_ID_DESC" />
      </fieldset>

      <fieldset name="telegram" label="PLG_SYSTEM_BALE_CHAT_TELEGRAM_SETTINGS">
        <field name="telegram_setup_note" type="note" heading="h4" label="PLG_SYSTEM_BALE_CHAT_TELEGRAM_SETUP_NOTE" description="PLG_SYSTEM_BALE_CHAT_TELEGRAM_SETUP_NOTE_DESC" />
        <field name="telegram_bot_username" type="text" label="PLG_SYSTEM_BALE_CHAT_TELEGRAM_USERNAME" description="PLG_SYSTEM_BALE_CHAT_TELEGRAM_USERNAME_DESC" />
        <field name="telegram_bot_token" type="password" label="PLG_SYSTEM_BALE_CHAT_TELEGRAM_TOKEN" description="PLG_SYSTEM_BALE_CHAT_TELEGRAM_TOKEN_DESC" />
        <field name="telegram_chatid_note" type="note" heading="h4" label="PLG_SYSTEM_BALE_CHAT_TELEGRAM_CHATID_NOTE" description="PLG_SYSTEM_BALE_CHAT_TELEGRAM_CHATID_NOTE_DESC" class="alert alert-warning" />
        <field name="telegram_chat_id" type="text" label="PLG_SYSTEM_BALE_CHAT_TELEGRAM_CHAT_ID" description="PLG_SYSTEM_BALE_CHAT_TELEGRAM_CHAT_ID_DESC" />
      </fieldset>

      <fieldset name="appearance" label="PLG_SYSTEM_BALE_CHAT_APPEARANCE">
        <field name="button_color" type="color" label="PLG_SYSTEM_BALE_CHAT_BUTTON_COLOR" description="PLG_SYSTEM_BALE_CHAT_BUTTON_COLOR_DESC" default="#0088cc" />
        <field name="welcome_message" type="textarea" label="PLG_SYSTEM_BALE_CHAT_WELCOME_MESSAGE" description="PLG_SYSTEM_BALE_CHAT_WELCOME_MESSAGE_DESC" default="سلام! چطور می‌توانم کمک کنم؟" rows="3" />
        <field name="widget_position" type="list" label="PLG_SYSTEM_BALE_CHAT_POSITION" description="PLG_SYSTEM_BALE_CHAT_POSITION_DESC" default="bottom-right">
          <option value="bottom-right">Bottom Right</option>
          <option value="bottom-left">Bottom Left</option>
        </field>
        <field name="fallback_timeout" type="number" label="PLG_SYSTEM_BALE_CHAT_TIMEOUT" description="PLG_SYSTEM_BALE_CHAT_TIMEOUT_DESC" default="4000" min="1000" max="10000" />
      </fieldset>
    </fields>
  </config>

  <languages folder="language">
    <language tag="en-GB">en-GB/plg_system_bale_chat.ini</language>
    <language tag="en-GB">en-GB/plg_system_bale_chat.sys.ini</language>
    <language tag="fa-IR">fa-IR/plg_system_bale_chat.ini</language>
    <language tag="fa-IR">fa-IR/plg_system_bale_chat.sys.ini</language>
    <language tag="ckb-IR">ckb-IR/plg_system_bale_chat.ini</language>
    <language tag="ckb-IR">ckb-IR/plg_system_bale_chat.sys.ini</language>
  </languages>

  <targetplatform name="joomla" version="4.*"/>
  <targetplatform name="joomla" version="5.*"/>
  <targetplatform name="joomla" version="6.*"/>
  <php_minimum>8.0</php_minimum>

  <changelog>
    <change date="2024-04-01" version="1.0.0">
      <item>Initial release</item>
      <item>Support for Bale Messenger and Telegram fallback</item>
      <item>AJAX contact form integration</item>
      <item>Customizable widget appearance and position</item>
      <item>Multi-language support: English, Persian, Kurdish-Sorani</item>
    </change>
  </changelog>

  <!--
    UPDATE SERVER
    Joomla checks this URL periodically. When a new release is published on
    GitHub the updates.xml at this URL is regenerated by build-plugin.py so
    admins see a badge under Extensions > Manage > Update and can one-click
    upgrade without leaving the Joomla admin panel.
    The raw URL always reflects the master branch; the file itself carries
    the current version number and the matching GitHub release download link.
  -->
  <updateservers>
    <server type="extension" priority="1" name="Bale ChatBox Widget Updates">
      https://raw.githubusercontent.com/vafagh/baleChatBox/master/updates.xml
    </server>
  </updateservers>
</extension>
